{
    "name": "lucamauri/robotstxt",
    "description": "MediaWiki extension that serves /robots.txt from the wiki, with the correct text/plain content type and sensible generated defaults.",
    "keywords": [
        "mediawiki",
        "extension",
        "robots.txt",
        "crawlers"
    ],
    "homepage": "https://github.com/lucamauri/RobotsTxt",
    "license": "GPL-2.0-or-later",
    "type": "mediawiki-extension",
    "authors": [
        {
            "name": "Luca Mauri",
            "homepage": "https://www.lucamauri.com"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "mediawiki/mediawiki-codesniffer": "^45.0"
    },
    "scripts": {
        "lint": "phpcs -p -s",
        "fix": "phpcbf"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
